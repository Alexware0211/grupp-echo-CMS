@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using Umbraco.Extensions
@{
    var lang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var metaTitle = Model.Value<string>("metaTitle");
    var metaDescription = Model.Value<string>("metaDescription");
    var pageTitle = ViewData["Title"] as string ?? (string.IsNullOrWhiteSpace(metaTitle) ? Model.Name : metaTitle);
}
<!doctype html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>document.documentElement.classList.add('js')</script>
    <title>@pageTitle | Kvarter</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription">
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="/css/site.css">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@Umbraco.GetDictionaryValueOrDefault("Site.SkipToContent", "Skip to content")</a>

    @await Html.PartialAsync("Site/Header", Model)

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Site/Footer", Model)

    <script src="/js/site.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>