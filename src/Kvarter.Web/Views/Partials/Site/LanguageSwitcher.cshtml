@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Globalization
@using Umbraco.Extensions
@{
    var current = CultureInfo.CurrentCulture.Name;
    var cultures = Model.Cultures.Keys.OrderByDescending(c => c).ToList();
}
@if (cultures.Count > 1)
{
    <ul class="lang-switch" aria-label="@Umbraco.GetDictionaryValueOrDefault("Site.Language", "Language")">
        @foreach (var culture in cultures)
        {
            var info = CultureInfo.GetCultureInfo(culture);
            var isCurrent = string.Equals(culture, current, StringComparison.OrdinalIgnoreCase);
            <li>
                <a class="lang-switch__link" href="@Model.Url(culture)" lang="@culture" hreflang="@culture"
                   title="@info.NativeName" aria-current="@(isCurrent ? "true" : null)">@info.TwoLetterISOLanguageName.ToUpperInvariant()</a>
            </li>
        }
    </ul>
}
