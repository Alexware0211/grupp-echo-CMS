{
    "$schema":  "appsettings-schema.json",
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information",
                                                          "System":  "Warning"
                                                      }
                                     }
                },
    "Umbraco":  {
                    "CMS":  {
                                "Global":  {
                                               "Id":  "d5fbd8a2-1031-4c31-b515-dcef0403242a"
                                           },
                                "Content":  {
                                                "AllowEditInvariantFromNonDefault":  true,
                                                "ContentVersionCleanupPolicy":  {
                                                                                    "EnableCleanup":  true
                                                                                }
                                            },
                                "Unattended":  {
                                                   "UpgradeUnattended":  true
                                               },
                                "Security":  {
                                                 "AllowConcurrentLogins":  false
                                             }
                            }
                },
    "uSync":  {
                  "Settings":  {
                                   "ImportAtStartup":  "All",
                                   "ExportOnSave":  "All"
                               }
              }
}
